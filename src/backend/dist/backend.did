type WithdrawKind = 
 variant {
   all;
   available;
 };
type Value = 
 variant {
   "bool": bool;
   float: float64;
   "int": int;
   "nat": nat;
   "null";
   "text": text;
 };
type UserRole = 
 variant {
   admin;
   guest;
   user;
 };
type TreasurySnapshot = 
 record {
   date: text;
   icp_amount: float64;
   icp_usd: float64;
   ogy_amount: float64;
   ogy_usd: float64;
   timestamp: nat64;
   total_usd: float64;
   wtn_amount: float64;
   wtn_usd: float64;
 };
type TournamentSummary = 
 record {
   closedAt: int;
   excavations: nat;
   forfeited: nat;
   jackpotPaid: nat;
   jackpots: nat;
   miniPaid: nat;
   minis: nat;
   payoutTotal: nat;
   players: nat;
   returned: nat;
   staked: nat;
   tournament: nat;
 };
type TournamentStats = 
 record {
   collapses: nat;
   deepest: nat;
   excavations: nat;
   jackpotWon: nat;
   jackpots: nat;
   miniWon: nat;
   minis: nat;
   returned: nat;
   staked: nat;
 };
type TopPrize = 
 record {
   player: principal;
   prize: nat;
   rank: nat;
   tournament: nat;
   volume: nat;
 };
type StakeOption = 
 variant {
   max;
   mid;
   min;
 };
type SecurityView = 
 record {
   accountingOk: bool;
   haltCode: nat;
   halted: bool;
   haltedAt: int;
   ledgerFails: nat;
   saturations: nat;
 };
type SecurityLogView = 
 record {
   day: nat;
   days: vec SecurityDay;
   events: vec SecurityEvent;
 };
type SecurityLevel = 
 variant {
   critical;
   info;
   warning;
 };
type SecurityEvent = 
 record {
   at: int;
   code: text;
   count: nat;
   description: text;
   lastAt: int;
   level: SecurityLevel;
   title: text;
 };
type SecurityDay = 
 record {
   attention: nat;
   day: nat;
   events: nat;
 };
type Result__1 = 
 record {
   hasMore: bool;
   rows: vec vec Cell;
 };
type Result_9 = 
 variant {
   err: text;
   ok: opt nat;
 };
type Result_8 = 
 variant {
   err: text;
   ok: vec Payout;
 };
type Result_7 = 
 variant {
   err: text;
   ok: SecurityView;
 };
type Result_6 = 
 variant {
   err: text;
   ok: SecurityLogView;
 };
type Result_5 = 
 variant {
   err: text;
   ok;
 };
type Result_4 = 
 variant {
   err: text;
   ok: AdminView;
 };
type Result_3 = 
 variant {
   err: text;
   ok: AutoResult;
 };
type Result_2 = 
 variant {
   err: text;
   ok: PickResult;
 };
type Result_13 = 
 variant {
   err: Error;
   ok;
 };
type Result_12 = 
 variant {
   err: text;
   ok: vec record {
             principal;
             UserRole;
           };
 };
type Result_11 = 
 variant {
   err: text;
   ok: bool;
 };
type Result_10 = 
 variant {
   err: text;
   ok: record {
         failed: nat;
         paid: nat;
         remaining: nat;
       };
 };
type Result_1 = 
 variant {
   err: text;
   ok: EndResult;
 };
type Result = 
 variant {
   err: text;
   ok: nat;
 };
type RankingSort = 
 variant {
   bestPrize;
   jackpot;
   net;
   volume;
 };
type RankingPage = 
 record {
   jackpots: vec JackpotWin;
   lastTop10: vec TopPrize;
   mine: opt PlayerRow;
   page: nat;
   pageSize: nat;
   rows: vec PlayerRow;
   sort: RankingSort;
   totalPlayers: nat;
 };
type PastStats = 
 record {
   excavations: nat;
   jackpotWon: nat;
   returned: nat;
   staked: nat;
 };
type PlayerTournamentResult = 
 record {
   credit: nat;
   payout: nat;
   stats: PastStats;
   tournament: nat;
 };
type PlayerRow = 
 record {
   bestReturn: nat;
   excavations: nat;
   jackpotWon: nat;
   net: int;
   player: principal;
   pos: nat;
   prize: nat;
   rank: nat;
   returned: nat;
   staked: nat;
 };
type PickResult = 
 record {
   collapsed: bool;
   credit: nat;
   diamond: DiamondResult;
   end: opt EndResult;
   excavation: opt ExcavationView;
   picks: nat;
   pool: nat;
 };
type Payout = 
 record {
   amount: nat;
   id: nat;
   paid: bool;
   paidAt: int;
   stamp: nat64;
   to: principal;
   tournament: nat;
   txId: opt nat;
   uncertain: bool;
 };
type JackpotWin = 
 record {
   amount: nat;
   at: int;
   player: principal;
   stake: nat;
   tournament: nat;
 };
type GameSummary = 
 record {
   endsAt: int;
   paused: bool;
   pool: nat;
   staked: nat;
   top10Pool: nat;
   totalPlayers: nat;
   tournament: nat;
 };
type GameConfig = 
 record {
   cells: nat;
   creditCapE8s: nat;
   diamond1Bps: nat;
   diamond2PerGoldao: nat;
   diamond3Odds: nat;
   feeE8s: nat;
   ledgerId: text;
   loadMax: nat;
   loadMin: nat;
   maxPicks: nat;
   minPayoutE8s: nat;
   mines: nat;
   miniBps: nat;
   payoutBps: nat;
   pointsTable: vec nat;
   poolSeedE8s: nat;
   poolSeedMaxE8s: nat;
   realLedger: bool;
   safePicks: nat;
   stakeCapE8s: nat;
   stakeMinE8s: nat;
   top10Bps: nat;
   top10MinVolumeE8s: nat;
   top10Weights: vec nat;
 };
type FaucetConfig = 
 record {
   capE8s: nat;
   enabled: bool;
   presets: vec nat;
   usedE8s: nat;
 };
type ExcavationView = 
 record {
   canSave: bool;
   collapseGross: nat;
   diamonds: nat;
   held: nat;
   jackpotWon: nat;
   nextGross: nat;
   picks: nat;
   runGross: nat;
   runPoints: nat;
   safePctX100: nat;
   stake: nat;
 };
type Error = 
 variant {
   AmbiguousAttribute: record {
                         field: text;
                         sources: vec text;
                       };
   FrontendOriginMismatch: record {
                             expected: vec text;
                             got: text;
                           };
   FrontendOriginsNotConfigured;
   MalformedCandid;
   MissingField: text;
   MixedSsoSources: record {
                      otherKeys: vec text;
                      ssoKeys: vec text;
                    };
   NoAttributes;
   Stale: record {ageNs: nat;};
   UnknownNonce;
   UntrustedSsoSource: record {domain: text;};
 };
type EndResult = 
 record {
   balance: nat;
   credit: nat;
   gross: nat;
   jackpotWon: nat;
   kind: EndKind;
   lost: nat;
   picks: nat;
   points: nat;
   stake: nat;
   won: nat;
 };
type EndKind = 
 variant {
   collapsed;
   maxed;
   saved;
 };
type DiamondResult = 
 record {
   stage: nat;
   won: nat;
 };
type Dashboard = 
 record {
   allowance: nat;
   balance: nat;
   bestReturn: nat;
   credit: nat;
   endsAt: int;
   history: vec PlayerTournamentResult;
   open: opt ExcavationView;
   paused: bool;
   pendingPayout: nat;
   pool: nat;
   stakes: vec nat;
   stats: TournamentStats;
   top10Entry: nat;
   top10Pool: nat;
   top10Prize: nat;
   top10Rank: nat;
   tournament: nat;
 };
type Cell = 
 record {
   name: text;
   value: Value;
 };
type AutoStep = 
 record {
   collapsed: bool;
   diamond: DiamondResult;
   pick: nat;
 };
type AutoResult = 
 record {
   end: EndResult;
   pool: nat;
   steps: vec AutoStep;
 };
type AdminView = 
 record {
   bank: nat;
   bankAccount: opt principal;
   bankAllowance: nat;
   burned: nat;
   cycles: nat;
   durationDays: nat;
   endsAt: int;
   fund: int;
   heldJackpots: nat;
   lastClose: opt TournamentSummary;
   owed: nat;
   paused: bool;
   payouts: vec Payout;
   pool: nat;
   realLedger: bool;
   reserve: nat;
   selfId: opt principal;
   smallBalances: nat;
   smallPlayers: nat;
   staked: nat;
   stakes: vec nat;
   toCollect: nat;
   toCollectPlayers: nat;
   top10: nat;
   tournament: nat;
   unpaidPayouts: nat;
   withdrawable: nat;
 };
service : {
  _initialize_access_control: () -> ();
  _internet_identity_sign_in_finish: () -> (Result_13);
  _internet_identity_sign_in_start: () -> (blob);
  adminListRoles: () -> (Result_12) query;
  adminSyncBootstrap: () -> (bool);
  assignCallerUserRole: (user: principal, role: UserRole) -> ();
  execute: (qJson: text) -> (Result__1) query;
  gameAdminAckAccounting: () -> (Result_5);
  gameAdminChangeLedger: () -> (Result);
  gameAdminCheckPay: () -> (Result_5) query;
  gameAdminCheckWithdraw: (kind: WithdrawKind) -> (Result_5) query;
  gameAdminCloseAll: () -> (Result_5);
  gameAdminCloseTournament: () -> (Result_5);
  gameAdminEnsureConnected: () -> (Result_11);
  gameAdminHalt: () -> (Result_5);
  gameAdminLedgerAllowance: (who: principal, spender: principal) -> (Result);
  gameAdminLedgerBalance: (who: principal) -> (Result);
  gameAdminMarkPaid: (id: nat, txId: nat) -> (Result_5);
  gameAdminPay: (max: nat) -> (Result_10);
  gameAdminPayOne: (id: nat, renew: bool) -> (Result_9);
  gameAdminPayouts: (tournament: nat) -> (Result_8) query;
  gameAdminRefreshBank: () -> (Result);
  gameAdminReleaseBusy: (player: principal) -> (Result_5);
  gameAdminResume: () -> (Result_5);
  gameAdminSecurity: () -> (Result_7) query;
  gameAdminSecurityLog: (day: nat) -> (Result_6) query;
  gameAdminSeedPool: (goldao: nat) -> (Result);
  gameAdminSetDuration: (days: nat) -> (Result_5);
  gameAdminView: () -> (Result_4) query;
  gameAdminWithdraw: (kind: WithdrawKind) -> (Result);
  gameAuto: (stake: StakeOption, stopAt: nat, expectedStake: nat) ->
   (Result_3);
  gameBurned: () -> (nat) query;
  gameConfig: () -> (GameConfig) query;
  gameLoadCredit: (goldao: nat) -> (Result);
  gameMyDashboard: () -> (Dashboard) query;
  gamePick: (stake: opt StakeOption, expectedStake: nat, expectedPicks:
   nat) -> (Result_2);
  gameRankingPage: (sort: RankingSort, page: nat) -> (RankingPage) query;
  gameSave: () -> (Result_1);
  gameSummary: () -> (GameSummary) query;
  gameTournaments: () -> (vec TournamentSummary) query;
  getCallerUserRole: () -> (UserRole) query;
  /// Full history sorted by date ascending.
  getTreasuryHistory: () -> (vec TreasurySnapshot) query;
  /// Check if a snapshot for the given date exists (cheap query).
  hasSnapshot: (date: text) -> (bool) query;
  isCallerAdmin: () -> (bool) query;
  /// Save a daily snapshot. Write-once per day, only for today's date (UTC), validated in the lib.
  saveTreasurySnapshot: (snapshot: TreasurySnapshot) -> (bool);
  schema: () -> (text) query;
  testFaucetClaim: (goldao: nat) -> (Result);
  testFaucetConfig: () -> (FaucetConfig) query;
  whoAmI: () -> (text) query;
}
